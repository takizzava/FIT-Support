# ============================================================
# FIT Support Bot — пример настроек
# ============================================================
#
# ВАЖНО:
# 1. Этот файл можно хранить в GitHub — реальных секретов здесь нет.
# 2. TELEGRAM_BOT_TOKEN и CHAT2DESK_API_TOKEN добавляются в Cloudflare:
#    Worker -> Settings -> Variables and Secrets -> Secrets.
# 3. Остальные параметры уже прописаны в wrangler.jsonc.
#

# ------------------------------------------------------------
# СЕКРЕТЫ — НЕ КОММИТИТЬ В GITHUB
# ------------------------------------------------------------

# Новый токен Telegram-бота из @BotFather.
# Старый токен, который был отправлен в чат, нужно перевыпустить.
TELEGRAM_BOT_TOKEN=CHANGE_ME

# API-токен Chat2Desk.
# В production добавляется как Cloudflare Secret.
CHAT2DESK_API_TOKEN=CHANGE_ME

# ------------------------------------------------------------
# CHAT2DESK
# ------------------------------------------------------------

# Базовый URL API. Уже прописан в wrangler.jsonc.
CHAT2DESK_API_BASE=https://api.chat2desk.com

# ------------------------------------------------------------
# РУКОВОДИТЕЛИ / АДМИНЫ
# ------------------------------------------------------------

# Админы определяются по Telegram username без @.
# Уже прописано в wrangler.jsonc.
ADMIN_TELEGRAM_USERNAMES=terraktorill,Des_pair

# ------------------------------------------------------------
# СОПОСТАВЛЕНИЕ ОПЕРАТОРОВ
# ------------------------------------------------------------
#
# Telegram numeric ID заранее НЕ требуется.
# Когда оператор впервые пишет боту /start или /id, Worker проверяет его
# @username по этому списку и запоминает numeric Telegram ID сам.
#
# Уже прописано в wrangler.jsonc одной строкой.
OPERATOR_MAP_JSON=[{"telegram_username":"terraktorill","chat2desk_operator_id":322416,"name":"Роман Онюшкин"},{"telegram_username":"Meldori","chat2desk_operator_id":322423,"name":"Егор Латышев"},{"telegram_username":"looking4victims","chat2desk_operator_id":322424,"name":"Миртемир Токтогулов"},{"telegram_username":"Warewarewarewa","chat2desk_operator_id":326121,"name":"Видана Мартынова"},{"telegram_username":"qRainyyy","chat2desk_operator_id":326575,"name":"Эрьян Муратов"},{"telegram_username":"Des_pair","chat2desk_operator_id":322395,"name":"Данила Ворончихин"}]

# ------------------------------------------------------------
# ПОИСК И ПАГИНАЦИЯ
# ------------------------------------------------------------
CLIENT_SEARCH_MAX_RESULTS=10
CLIENT_SEARCH_FALLBACK_PAGES=10
TICKETS_PER_PAGE=5

# Мне стало лень придумывать секреты для setup и webhook, поэтому я просто сгенерировал их на random.org.
CHAT2DESK_API_TOKEN=104ef5b492382323bf95646bc53c53

SETUP_SECRET=fit-support-setup-2pR8mX7qW4nK9sD6bF1yH5cJ

TELEGRAM_BOT_TOKEN=8754438073:AAES0cVo2ZleLvyB_n4SffW13uiQSnHefCM

TELEGRAM_WEBHOOK_SECRET=fit-support-telegram-7dKp91xM4vN2sQ8rL6cZ5wH3